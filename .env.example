# ─────────────────────────────────────────────────────────────
#  Ростехсталь — переменные окружения
#  Скопируйте в .env.local и заполните. Все NEXT_PUBLIC_* попадают
#  в браузер, поэтому НЕ кладите сюда секреты.
# ─────────────────────────────────────────────────────────────

# Канонический адрес сайта. Задайте после покупки домена, напр.:
#   https://rostehstal.kg
# Если не задан — используется прод-домен Vercel, затем http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# ── Веб-аналитика (продвижение) ──────────────────────────────
# Номер счётчика Яндекс.Метрики (Метрика → Настройки → Номер счётчика)
NEXT_PUBLIC_YM_ID=
# Measurement ID Google Analytics 4 вида G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=
# Конверсия Google Ads для заявки: "AW-XXXXXXXXXX/AbCdEfGh" (ID/метка из Google Ads → Конверсии)
NEXT_PUBLIC_GOOGLE_ADS_SEND_TO=

# ── Верификация в панелях вебмастеров ────────────────────────
# Яндекс.Вебмастер → Настройки → Подтверждение прав → Мета-тег (значение content)
NEXT_PUBLIC_YANDEX_VERIFICATION=
# Google Search Console → HTML-тег (значение content)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ── Виджет онлайн-чата JivoChat (необязательно) ──────────────
NEXT_PUBLIC_JIVO_ID=

# ── Админка ──────────────────────────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SECRET=
ADMIN_SALT=
